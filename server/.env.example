# CampusMind_AI Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Authentication
JWT_SECRET=supersecret_campusmind_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Database (Leave empty to use automatic in-memory MongoDB fallback)
MONGO_URI=

# Vector Database (Leave empty to use built-in local vector fallback store)
PINECONE_API_KEY=
PINECONE_INDEX=campusmind
PINECONE_ENVIRONMENT=us-east-1

# AI Providers (Optional - system uses extractive fallback if none are provided)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# RAG & Ingestion Configuration
CHUNK_SIZE=600
CHUNK_OVERLAP=100
SIMILARITY_TOP_K=5
SIMILARITY_THRESHOLD=0.35
